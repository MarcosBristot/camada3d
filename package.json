{
  "name": "camada3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:localdb": "vite --mode localdb",
    "db:start": "supabase start -x realtime,edge-runtime,logflare,vector,supavisor,imgproxy",
